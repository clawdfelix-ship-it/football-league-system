# Database Connection String
# Get this from your Neon Console (https://console.neon.tech)
DATABASE_URL="postgresql://user:password@ep-host-123456.region.aws.neon.tech/neondb?sslmode=require"

# Admin Secret for Database Initialization (Production only)
# Set this to a secure random string to protect the /api/init-db endpoint
# Also used as Bearer token when calling /api/init-db
ADMIN_SECRET="change-this-to-a-secure-random-string"

# Admin Credentials for /admin access (Required - no defaults)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-to-a-secure-password"

# Team Manager Login Password (Required - no defaults)
# All manager accounts use this shared password for initial login
MANAGER_PASSWORD="change-this-to-a-secure-password"

# NextAuth Secret (Required for production)
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-secure-random-string"
NEXTAUTH_URL="http://localhost:3000" # Change to your Vercel URL in production

# Vercel Blob Storage Token (for player photo uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_token_here"

# --- Email (Zoho SMTP) -------------------------------------------------------
# When unset, outbound email is silently disabled (login/reset still work).
SMTP_HOST="smtp.zoho.com"        # use smtp.zoho.com.hk for Zoho HK if needed
SMTP_PORT="465"                  # 465 = SSL; 587 = STARTTLS
SMTP_USER="hello@example.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="hello@example.com"    # defaults to SMTP_USER if omitted
MAIL_FROM_NAME="Zenex Sports League"

# --- Multi-tenant SaaS (Phase 3/5) ------------------------------------------
# Apex domain that hosts per-league subdomains {slug}.TENANT_BASE_DOMAIN
TENANT_BASE_DOMAIN="zenex-sports.com"
# Extra hostnames that serve the platform console (comma-separated)
PLATFORM_HOSTS=""
# Founding league (served on vercel.app / localhost / unknown apex)
DEFAULT_LEAGUE_SLUG="hkbankleague2026"
DEFAULT_LEAGUE_ID="1"
# Trial length in days stamped on a newly provisioned league (0 = open-ended)
TRIAL_DAYS="14"
# Comma- or semicolon-separated allow-list of platform console admins
# (these can review/provision leagues at https://<apex>/platform)
PLATFORM_ADMIN_EMAILS="you@example.com,ops@example.com"
# Manager email -> team-index map (JSON). Alternative to the gitignored
# lib/auth/manager-mapping.server.ts file. Values are TEAMS array indices.
MANAGER_MAPPING_JSON='{"manager@example.com":0}'
# Allow public self-service registration (when the league permits it)
ALLOW_PUBLIC_REGISTER="false"
# Canonical public base URL (used when building links in emails)
APP_BASE_URL="https://hkbankleague2026.zenex-sports.com"
